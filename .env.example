# Cursor API — the ONLY key required for image generation (prompts, isolation, scene, composite, pro mode)
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_your_key_here

# ── Publishing (optional, per-platform) ──────────────────────────────────
# Only needed for the final "Publish" step to post directly to a platform.
# Without these, the design is still exported and the action is recorded as
# "needs connection". Caption + hashtag generation uses CURSOR_API_KEY only.

# Meta (Instagram + Facebook) Graph API.
# NOTE: Meta fetches the image by URL, so it must be publicly reachable
# (localhost won't work — deploy or use a tunnel).
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_FB_PAGE_ID=

# Pinterest API v5 (image uploaded inline — works on localhost):
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# LinkedIn (image uploaded as binary — works on localhost).
# LINKEDIN_AUTHOR_URN is urn:li:person:XXXX or urn:li:organization:XXXX
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# X / Twitter — OAuth 1.0a user context (works on localhost):
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
